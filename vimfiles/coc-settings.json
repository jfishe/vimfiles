{
  // CoC
  "suggest.noselect": true,
  // Pyright: type checking, completion, hover (ruff owns lint/format)
  "python.formatting.provider": "none",
  "python.analysis.typeCheckingMode": "standard",
  "pyright.organizeimports.provider": "ruff",
  "pyright.testing.provider": "pytest",
  // PowerShell
  "powershell.scriptAnalysis.enable": true,
  "powershell.integratedConsole.showOnStartup": false,
  "powershell.codeFormatting.preset": "OTBS",
  "powershell.powerShellExePath": "pwsh",
  // Ruff (native server: lint + format + organize imports)
  // sic: key is misspelled upstream
  "ruff.client.codeAction.showDocumantaion.enable": true,
  // Ultisnips
  "snippets.ultisnips.pythonPrompt": false
}
